# Copy to .env and fill in. Never commit .env.
DEV=1                         # 1 = auto-reload + print login emails to console instead of sending
SECRET_KEY=change-me          # long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EMAILS=alex.tan@example.com  # comma-separated; seed admin (also a participant)
BASE_URL=http://localhost:8080  # production: https://santa.mangobello.dev (required, https)
DB_PATH=data/gift.db
HOST=127.0.0.1                # 0.0.0.0 to test from your phone on the LAN, and in Docker
PORT=8080
RESEND_API_KEY=               # required when DEV != 1
EMAIL_FROM=Santa <santa@mail.mangobello.dev>  # required when DEV != 1
